// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DailyAttendance {
  id               String   @id @default(uuid())
  date             DateTime @db.Date
  departmentKey    String
  shift            String   // "day", "night", "zero"
  quadro               Float    @default(0)
  plannedAbsence       Float    @default(0)
  unplannedAbsence     Float    @default(0)
  indeterminateAbsence Float    @default(0)
  updatedAt            DateTime @updatedAt

  @@unique([date, departmentKey, shift])
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         String   @default("user") // "admin" | "user"
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String?  // null = ação de sistema (sem usuário logado, ex.: cron)
  username  String   // denormalizado — sobrevive à exclusão do usuário
  action    String   // ex.: "attendance.update", "user.create", "user.delete"
  target    String   // descrição legível do que foi alterado
  details   Json?    // payload estruturado (before/after, etc.) — nunca senhas

  @@index([createdAt])
}
