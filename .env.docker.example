# Variáveis usadas pelo docker-compose na VM.
# Copie para ".env.docker" e ajuste os valores:
#   cp .env.docker.example .env.docker

# --- Porta do host onde a app fica exposta ---
# A porta interna do container é sempre 3000; esta é a porta da VM.
# Use 3001 (ou outra livre) porque a 3000 já está ocupada por outra instância.
APP_PORT=3001

# --- Banco de dados PostgreSQL (container "db") ---
POSTGRES_USER=attendance
POSTGRES_PASSWORD=troque-esta-senha-forte
POSTGRES_DB=attendance

# --- Segredo do cron de snapshot ---
# Use uma string aleatória forte. Ex.: openssl rand -hex 32
CRON_SECRET=troque-este-segredo

# --- Segredo usado para assinar o cookie de sessão (login) ---
# Use uma string aleatória forte. Ex.: openssl rand -hex 32
# Trocar este valor invalida todas as sessões já logadas (força novo login).
AUTH_SECRET=troque-este-segredo-tambem

# --- Cookie de sessão sem exigir HTTPS (TEMPORÁRIO) ---
# Por padrão, o cookie de login só é enviado pelo navegador em conexões
# HTTPS. Se o servidor ainda não tem HTTPS configurado na frente (ex.: NPM
# sem certificado), o login não vai manter sessão nenhuma até você ligar
# esta flag — mas isso faz o cookie trafegar em texto puro na rede.
# Só use em rede interna confiável, e REMOVA assim que configurar HTTPS.
# AUTH_ALLOW_INSECURE_COOKIE=true

# --- Retenção do backup diário do Postgres (dias) ---
# Backups mais antigos que isso são apagados automaticamente. Opcional,
# default 14 dias se não definir.
BACKUP_RETENTION_DAYS=14

# Obs: o DATABASE_URL NÃO é definido aqui. Ele é montado automaticamente
# pelo docker-compose a partir das variáveis POSTGRES_* acima.
